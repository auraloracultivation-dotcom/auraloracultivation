 "chat": [
  [
   "Hôm nay Thanh Vân Trấn đông vui quá.",
   "Nghe nói có đạo hữu mới nhập thế."
  ],
  [
   "Đạo hữu tu luyện tới tầng mấy rồi?",
   "Mới Luyện Khí tầng ba, còn xa lắm."
  ],
  [
   "Vạn Bảo Lâu vừa nhập đan phương mới.",
   "Linh thạch đâu mà mua, haizz."
  ],
  [
   "Ngoài bìa rừng Yêu Hồ lại quấy phá.",
   "Để ta ra đó luyện kiếm một phen."
  ],
  [
   "Bãi đá phía đông có Tinh Sa.",
   "Tối nay ta đi đào thử."
  ],
  [
   "Sơn Động Lão Yêu mạnh lắm đấy.",
   "Phải chuẩn bị đan dược mới dám đánh."
  ],
  [
   "Lò luyện đan hôm nay nổ ba lần.",
   "Chắc lửa quá mạnh rồi, hahaha."
  ],
  [
   "Ngươi có thấy Pháp tướng của trưởng lão chưa?",
   "Thấy rồi, uy áp kinh người!"
  ],
  [
   "Có Trúc Cơ Đan cũng chưa chắc thành — thiên kiếp phản phệ mất nửa đời tu.",
   "Thêm Bảo hộ phù cho chắc."
  ],
  [
   "Mai lên vùng Cam săn Huyết Sài không?",
   "Đi! Hẹn ở cầu đông."
  ],
  [
   "Tuyết Sơn lạnh thấu xương.",
   "Mang theo Hồi Linh Đan nhé."
  ],
  [
   "Kiếm của đạo hữu đẹp thật.",
   "Thức tỉnh ba lần mới ra phẩm Tím đó."
  ],
  [
   "Thiên kiếp hôm qua sấm chớp ầm ầm.",
   "Có người vừa đột phá Trúc Cơ."
  ],
  [
   "Ta muốn gia nhập tông môn.",
   "Chờ tông môn mở đã, nghe nói sắp rồi."
  ],
  [
   "Hồ sen trong thành đẹp quá.",
   "Ngồi đây tĩnh tu một lát cũng tốt."
  ]
 ],
 "greet": [
  "Đạo hữu khỏe chứ?",
  "Thanh Vân Thành chào đón ngươi!",
  "Ra ngoài nhớ cẩn thận yêu thú.",
  "Muốn mua đan phương thì ghé Vạn Bảo Lâu.",
  "Tu đạo gian nan, cố lên!",
  "Đi theo đường lớn sẽ an toàn hơn.",
  "Rừng phía nam nhiều linh thảo lắm.",
  "Hôm nay trời đẹp, thích hợp luyện kiếm."
 ],
 "respawn_s": 20,
 "revive_guard_s": 10,
 "_ghi_chu_pvp": "Cảnh giới NPC: stage (chỉ số theo data/gameplay.json → player.stages). shield = bật khiên (không đánh nhau). NPC tắt khiên ngoài thành tự đánh người chơi / NPC tắt khiên gần; gục thì hồi sinh ở nhà sau respawn_s, được bảo vệ revive_guard_s."
}
